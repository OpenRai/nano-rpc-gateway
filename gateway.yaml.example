listen: "127.0.0.1:8090"
node_rpc_urls:
  - "http://127.0.0.1:7076"
node_ws_urls:
  - "ws://127.0.0.1:7078"
# Public provider examples (set variables in the local .env; do not commit secrets):
# node_rpc_urls:
#   - "https://${NANO_TO_API_KEY}:@rpc.nano.to/"
#   - "https://nodes.nanswap.com/XNO?api_key=${NANSWAP_COM_API_KEY}"
# node_ws_urls:
#   - "wss://nodes.nanswap.com/ws/?ticker=XNO&api_key=${NANSWAP_COM_API_KEY}"
#   - "wss://ws.nano.to"
profile: "nano-node/V28.2"
require_common_auth: true
allow_work: false
allow_control: false
auth_public_key: null
enable_discovery: true
log_rpc: false
# Browser origins allowed to call this gateway. CORS is a browser-enforced policy,
# not access control: every endpoint here is already reachable by any non-browser
# client, so the default stays permissive and this list is not a security boundary.
# `*` is incompatible with cookie-based credentials; Authorization-header tokens are
# unaffected. Narrow this to the known web origins once a deployment has them.
cors_origins:
  - "*"
# Full public JSON-RPC endpoint advertised in /openrpc.json and /asyncapi.json.
# Set this whenever a tunnel or reverse proxy fronts the gateway, so the published
# contracts advertise the reachable address instead of the local bind address.
# Leave null to derive the advertised URL from `listen`.
public_url: null
tls_cert: null
tls_key: null
