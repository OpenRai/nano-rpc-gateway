{
  "components": {
    "schemas": {
      "AccountBalanceParams": {
        "properties": {
          "account": {
            "minLength": 1,
            "type": "string"
          },
          "include_only_confirmed": {
            "default": true,
            "description": "Report only blocks whose confirmation height is up to date.",
            "type": "boolean"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "AccountBalanceResult": {
        "properties": {
          "balance": {
            "description": "Balance in raw. Confirmed only when include_only_confirmed is true.",
            "type": "string"
          },
          "receivable": {
            "description": "Incoming amount not yet received, in raw.",
            "type": "string"
          }
        },
        "required": [
          "balance",
          "receivable"
        ],
        "type": "object"
      },
      "AccountHistoryParams": {
        "properties": {
          "account": {
            "minLength": 1,
            "type": "string"
          },
          "account_filter": {
            "description": "Only return entries connected to these accounts.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "count": {
            "description": "Maximum number of entries. -1 returns the whole chain.",
            "type": "integer"
          },
          "head": {
            "description": "Start from this block instead of the account's latest, and include it as the first entry. Use it to paginate.",
            "maxLength": 64,
            "minLength": 64,
            "type": "string"
          },
          "include_linked_account": {
            "default": false,
            "description": "Add `linked_account` to each entry, or \"0\" when there is none or the block is pruned.",
            "type": "boolean"
          },
          "offset": {
            "description": "Skip this many blocks, starting from head when given.",
            "type": "integer"
          },
          "raw": {
            "default": false,
            "description": "Return full block content instead of a send/receive summary. Required to see change and epoch blocks, which the summary skips.",
            "type": "boolean"
          },
          "reverse": {
            "default": false,
            "description": "Walk forward from head toward the frontier instead of backward. The response reports `next` in place of `previous`.",
            "type": "boolean"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "AccountHistoryResult": {
        "properties": {
          "account": {
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "type": "array"
          },
          "next": {
            "description": "Present in place of `previous` when `reverse` was requested.",
            "type": "string"
          },
          "previous": {
            "description": "Present only when `count` truncated the result: the hash to pass as the next `head`.",
            "type": "string"
          }
        },
        "required": [
          "account",
          "history"
        ],
        "type": "object"
      },
      "AccountInfoParams": {
        "properties": {
          "account": {
            "minLength": 1,
            "type": "string"
          },
          "include_confirmed": {
            "default": false,
            "description": "Add the confirmed_ fields. Without it the response carries no confirmed_* fields.",
            "type": "boolean"
          },
          "receivable": {
            "default": false,
            "description": "Add the receivable total, plus confirmed_receivable when include_confirmed is also set.",
            "type": "boolean"
          },
          "representative": {
            "default": false,
            "description": "Add the representative account.",
            "type": "boolean"
          },
          "weight": {
            "default": false,
            "description": "Add the account's voting weight.",
            "type": "boolean"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "AccountInfoResult": {
        "description": "Fields beyond this set appear only when the matching request parameter is set.",
        "properties": {
          "account_version": {
            "type": "string"
          },
          "balance": {
            "description": "Balance at frontier, in raw. It can include unconfirmed state.",
            "type": "string"
          },
          "block_count": {
            "type": "string"
          },
          "confirmation_height": {
            "description": "Cemented blocks on the account chain.",
            "type": "string"
          },
          "confirmation_height_frontier": {
            "description": "The block hash at confirmation_height.",
            "type": "string"
          },
          "confirmed_balance": {
            "description": "Present when `include_confirmed` was requested.",
            "type": "string"
          },
          "confirmed_frontier": {
            "description": "Present when `include_confirmed` was requested. Confirm a frontier with blocks_info before treating it as final.",
            "type": "string"
          },
          "confirmed_height": {
            "description": "Present when `include_confirmed` was requested. Same value as confirmation_height.",
            "type": "string"
          },
          "confirmed_receivable": {
            "description": "Present when both `receivable` and `include_confirmed` were requested.",
            "type": "string"
          },
          "confirmed_representative": {
            "description": "Present when both `representative` and `include_confirmed` were requested.",
            "type": "string"
          },
          "frontier": {
            "description": "Current frontier hash. It can be ahead of cemented state.",
            "type": "string"
          },
          "modified_timestamp": {
            "type": "string"
          },
          "open_block": {
            "type": "string"
          },
          "receivable": {
            "description": "Present when `receivable` was requested.",
            "type": "string"
          },
          "representative": {
            "description": "Present when `representative` was requested.",
            "type": "string"
          },
          "representative_block": {
            "type": "string"
          },
          "weight": {
            "description": "Present when `weight` was requested.",
            "type": "string"
          }
        },
        "required": [
          "frontier",
          "open_block",
          "representative_block",
          "balance",
          "modified_timestamp",
          "block_count",
          "account_version"
        ],
        "type": "object"
      },
      "AccountsBalancesResult": {
        "description": "Both maps are optional; the node omits one when no entry applies to it. An account absent from the ledger reports a zero balance and zero receivable rather than an error.",
        "properties": {
          "balances": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AccountBalanceResult"
            },
            "description": "One entry per requested account. This is not an aggregate.",
            "type": "object"
          },
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-account error message.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "AccountsFrontiersParams": {
        "properties": {
          "accounts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "accounts"
        ],
        "type": "object"
      },
      "AccountsFrontiersResult": {
        "description": "Both maps are optional. The node omits `frontiers` when every requested account failed and omits `errors` when none did. A head block can be unconfirmed, so confirm it with blocks_info and read `confirmed` before treating it as final.",
        "properties": {
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Account to the node's message for that account.",
            "type": "object"
          },
          "frontiers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Account to head block hash.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "AccountsParams": {
        "properties": {
          "accounts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "include_only_confirmed": {
            "default": true,
            "description": "Only count blocks whose confirmation height is up to date.",
            "type": "boolean"
          }
        },
        "required": [
          "accounts"
        ],
        "type": "object"
      },
      "AccountsReceivableParams": {
        "properties": {
          "accounts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "count": {
            "description": "Maximum number of blocks to return per account.",
            "type": "integer"
          },
          "include_active": {
            "default": false,
            "description": "Include blocks without a finished confirmation.",
            "type": "boolean"
          },
          "include_only_confirmed": {
            "default": true,
            "description": "Only return blocks whose confirmation height is up to date.",
            "type": "boolean"
          },
          "sorting": {
            "default": false,
            "description": "Sort each account's blocks by amount, descending.",
            "type": "boolean"
          },
          "source": {
            "default": false,
            "description": "Include the sending account with each block. Selects the hash-to-object result shape.",
            "type": "boolean"
          },
          "threshold": {
            "description": "Only return blocks whose amount is at least this value, in raw. Selects the hash-to-amount result shape.",
            "type": "string"
          }
        },
        "required": [
          "accounts"
        ],
        "type": "object"
      },
      "AccountsReceivableResult": {
        "properties": {
          "blocks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReceivableBlocks"
            },
            "description": "Account to that account's receivable blocks.",
            "type": "object"
          }
        },
        "required": [
          "blocks"
        ],
        "type": "object"
      },
      "BlockConfirmParams": {
        "properties": {
          "hash": {
            "description": "The block to ask online representatives about.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "hash"
        ],
        "type": "object"
      },
      "BlockConfirmResult": {
        "properties": {
          "started": {
            "const": "1",
            "type": "string"
          }
        },
        "required": [
          "started"
        ],
        "type": "object"
      },
      "BlockCountResult": {
        "properties": {
          "cemented": {
            "type": "string"
          },
          "count": {
            "type": "string"
          },
          "unchecked": {
            "type": "string"
          }
        },
        "required": [
          "count",
          "unchecked",
          "cemented"
        ],
        "type": "object"
      },
      "BlockInfoResult": {
        "description": "`subtype` is present for state blocks only, and is the source of truth for a state block's kind.",
        "properties": {
          "amount": {
            "description": "Block amount in raw.",
            "type": "string"
          },
          "balance": {
            "description": "Account balance after this block, in raw.",
            "type": "string"
          },
          "block_account": {
            "description": "Account that owns the block.",
            "type": "string"
          },
          "confirmed": {
            "description": "\"true\" only when the node reports the block cemented.",
            "type": "string"
          },
          "contents": {
            "description": "Block content. A JSON string unless `json_block` was requested."
          },
          "height": {
            "type": "string"
          },
          "linked_account": {
            "description": "Present when include_linked_account was requested; \"0\" when there is none.",
            "type": "string"
          },
          "local_timestamp": {
            "type": "string"
          },
          "receive_hash": {
            "type": "string"
          },
          "source_account": {
            "type": "string"
          },
          "subtype": {
            "enum": [
              "send",
              "receive",
              "change",
              "epoch"
            ],
            "type": "string"
          },
          "successor": {
            "description": "The block that superseded this one.",
            "type": "string"
          }
        },
        "required": [
          "block_account",
          "amount",
          "balance",
          "height",
          "local_timestamp",
          "confirmed"
        ],
        "type": "object"
      },
      "BlockParams": {
        "properties": {
          "hash": {
            "minLength": 1,
            "type": "string"
          },
          "include_linked_account": {
            "default": false,
            "description": "Add `linked_account`, or \"0\" when there is none or the block is pruned.",
            "type": "boolean"
          },
          "json_block": {
            "default": false,
            "description": "Return `contents` as a JSON subtree instead of a JSON string.",
            "type": "boolean"
          }
        },
        "required": [
          "hash"
        ],
        "type": "object"
      },
      "BlocksInfoResult": {
        "properties": {
          "blocks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/BlockInfoResult"
            },
            "type": "object"
          },
          "blocks_not_found": {
            "description": "Present when include_not_found was requested.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "blocks"
        ],
        "type": "object"
      },
      "BlocksParams": {
        "properties": {
          "hashes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "include_linked_account": {
            "default": false,
            "description": "Add `linked_account`, or \"0\" when there is none or the block is pruned.",
            "type": "boolean"
          },
          "include_not_found": {
            "default": false,
            "description": "Report unknown hashes in `blocks_not_found` instead of failing.",
            "type": "boolean"
          },
          "json_block": {
            "default": false,
            "description": "Return `contents` as a JSON subtree instead of a JSON string.",
            "type": "boolean"
          },
          "receive_hash": {
            "default": false,
            "description": "For send blocks, add the matching receive block hash.",
            "type": "boolean"
          },
          "source": {
            "default": false,
            "description": "Add `source_account` for receive and open blocks, and \"0\" for send and change blocks.",
            "type": "boolean"
          }
        },
        "required": [
          "hashes"
        ],
        "type": "object"
      },
      "EmptyParams": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "HistoryEntry": {
        "description": "Without `raw`, `type` is `send` or `receive` and change and epoch blocks are skipped. With `raw`, it is the block type and every block field is present. For an open block in raw mode, `account` is the source block's account.",
        "properties": {
          "account": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "balance": {
            "type": "string"
          },
          "confirmed": {
            "description": "\"true\" when the node reports the entry cemented.",
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "height": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "link_as_account": {
            "type": "string"
          },
          "linked_account": {
            "description": "Present when include_linked_account was requested.",
            "type": "string"
          },
          "local_timestamp": {
            "type": "string"
          },
          "previous": {
            "description": "Hash of the preceding block on the account chain.",
            "type": "string"
          },
          "representative": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "subtype": {
            "description": "State blocks only. The source of truth for the block's kind.",
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "work": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "account",
          "amount",
          "hash"
        ],
        "type": "object"
      },
      "ProcessParams": {
        "properties": {
          "async": {
            "default": false,
            "description": "Queue the block and return `started` immediately instead of waiting. The outcome arrives on the `new_unconfirmed_block` topic.",
            "type": "boolean"
          },
          "block": {
            "additionalProperties": true,
            "type": "object"
          },
          "force": {
            "default": false,
            "description": "Force fork resolution when the block is not accepted as the fork.",
            "type": "boolean"
          },
          "json_block": {
            "default": false,
            "description": "Send `block` as a JSON subtree instead of a JSON string.",
            "type": "boolean"
          },
          "subtype": {
            "description": "Extra check on the block's intent. Strongly recommended, and required in a future node version.",
            "enum": [
              "send",
              "receive",
              "open",
              "change",
              "epoch"
            ],
            "type": "string"
          }
        },
        "required": [
          "block"
        ],
        "type": "object"
      },
      "ProcessResult": {
        "oneOf": [
          {
            "properties": {
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "hash"
            ],
            "type": "object"
          },
          {
            "description": "Returned when `async` was requested. The block was queued, not processed; the outcome arrives on the `new_unconfirmed_block` topic.",
            "properties": {
              "started": {
                "const": "1",
                "type": "string"
              }
            },
            "required": [
              "started"
            ],
            "type": "object"
          }
        ]
      },
      "ReceivableBlocks": {
        "description": "The node selects one of three shapes from the request parameters: an array of hashes by default, hash to amount with `threshold`, and hash to amount and source account with `source`.",
        "oneOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReceivableSource"
            },
            "type": "object"
          }
        ]
      },
      "ReceivableParams": {
        "properties": {
          "account": {
            "minLength": 1,
            "type": "string"
          },
          "count": {
            "description": "Maximum number of blocks to return.",
            "type": "integer"
          },
          "include_active": {
            "default": false,
            "description": "Include blocks without a finished confirmation.",
            "type": "boolean"
          },
          "include_only_confirmed": {
            "default": true,
            "description": "Only return blocks whose confirmation height is up to date.",
            "type": "boolean"
          },
          "min_version": {
            "description": "Only return blocks that this version (epoch) or later can pocket.",
            "type": "integer"
          },
          "sorting": {
            "default": false,
            "description": "Sort blocks by amount, descending.",
            "type": "boolean"
          },
          "source": {
            "default": false,
            "description": "Include the sending account with each block. Selects the hash-to-object result shape.",
            "type": "boolean"
          },
          "threshold": {
            "description": "Only return blocks whose amount is at least this value, in raw. Selects the hash-to-amount result shape.",
            "type": "string"
          }
        },
        "required": [
          "account"
        ],
        "type": "object"
      },
      "ReceivableResult": {
        "properties": {
          "blocks": {
            "$ref": "#/components/schemas/ReceivableBlocks"
          }
        },
        "required": [
          "blocks"
        ],
        "type": "object"
      },
      "ReceivableSource": {
        "properties": {
          "amount": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "source"
        ],
        "type": "object"
      },
      "VersionResult": {
        "properties": {
          "build_info": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "network_identifier": {
            "description": "Hash of the genesis open block.",
            "type": "string"
          },
          "node_vendor": {
            "type": "string"
          },
          "protocol_version": {
            "type": "string"
          },
          "rpc_version": {
            "type": "string"
          },
          "store_vendor": {
            "type": "string"
          },
          "store_version": {
            "type": "string"
          }
        },
        "required": [
          "rpc_version"
        ],
        "type": "object"
      }
    }
  },
  "errors": {
    "InvalidRequest": {
      "code": -32602,
      "message": "Invalid method parameters"
    },
    "MethodNotFound": {
      "code": -32601,
      "message": "Method not found"
    },
    "NodeError": {
      "code": -32000,
      "message": "The node reported an error. This is the only code the gateway uses for node-reported errors, and the message is the node's own string unchanged."
    },
    "UpstreamUnavailable": {
      "code": -32000,
      "message": "The node could not be reached. The call may or may not have been processed."
    }
  },
  "info": {
    "description": "JSON-RPC 2.0 adapter for a pinned Nano node profile.",
    "title": "Nano Gateway",
    "version": "0.1.0"
  },
  "methods": [
    {
      "errors": [
        {
          "$ref": "#/components/errors/InvalidRequest"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/NodeError"
        },
        {
          "$ref": "#/components/errors/UpstreamUnavailable"
        }
      ],
      "name": "version",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/VersionResult"
        }
      },
      "summary": "Read the upstream node version.",
      "x-nano-params-schema": {
        "$ref": "#/components/schemas/EmptyParams"
      },
      "x-nano-schema-provenance": "profiles/nano-node-v28.2.yaml"
    },
    {
      "errors": [
        {
          "$ref": "#/components/errors/InvalidRequest"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/NodeError"
        },
        {
          "$ref": "#/components/errors/UpstreamUnavailable"
        }
      ],
      "name": "block_count",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/BlockCountResult"
        }
      },
      "summary": "Read upstream ledger block counts.",
      "x-nano-params-schema": {
        "$ref": "#/components/schemas/EmptyParams"
      },
      "x-nano-schema-provenance": "profiles/nano-node-v28.2.yaml"
    },
    {
      "errors": [
        {
          "$ref": "#/components/errors/InvalidRequest"
        },
        {
          "$ref": "#/components/errors/MethodNotFound"
        },
        {
          "$ref": "#/components/errors/NodeError"
        },
        {
          "$ref": "#/components/errors/UpstreamUnavailable"
        }
      ],
      "name": "account_info",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "account",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "include_confirmed",
          "required": false,
          "schema": {
            "default": false,
            "description": "Add the confirmed_ fields. Without it the response carries no confirmed_* fields.",
            "type": "boolean"
          }
        },
        {
          "name": "receivable",
          "required": false,
          "schema": {
            "default": false,
            "description": "Add the receivable total, plus confirmed_receivable when include_confirmed is also set.",
            "type": "boolean"
          }
        },
        {
          "name": "representative",
          "required": false,
          "schema": {
            "default": false,
            "description": "Add the representative account.",
            "type": "boolean"
          }
        },
        {
          "name": "weight",
          "required": false,
          "schema": {
            "default": false,
            "description": "Add the account's voting weight.",
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/AccountInfoResult"
